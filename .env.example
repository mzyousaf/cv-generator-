# Copy to `.env.local` for local development. Never commit real secrets.
# All variables below are server-only (no NEXT_PUBLIC_* in this app).

# --- Required (runtime) ---
# MongoDB connection string (Atlas or self-hosted).
MONGODB_URI=
# Database name for this app instance (use separate names per environment).
MONGODB_DB_NAME=cv-generator-development

# --- Required in production ---
# Session/JWT signing secret. Generate: openssl rand -base64 32
AUTH_SECRET=
# Canonical site URL (e.g. https://your-app.vercel.app). Strongly recommended in production.
AUTH_URL=http://localhost:3000

# --- Optional: Google OAuth (both required if you enable Google sign-in) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Optional: AI assist (server-only; AI features are disabled when no key is set) ---
# OpenRouter (recommended): paste your key from https://openrouter.ai/keys — that's all you need.
OPENROUTER_API_KEY=
# Any OpenRouter model id (https://openrouter.ai/models). Defaults to openai/gpt-4o-mini.
AI_MODEL=openai/gpt-4o-mini
# Optional OpenRouter attribution headers (HTTP-Referer falls back to AUTH_URL).
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=CV Generator

# Alternative: OpenAI or another OpenAI-compatible API (used only if OPENROUTER_API_KEY is empty).
OPENAI_API_KEY=
# AI_BASE_URL overrides the API base URL for either provider.
# AI_BASE_URL=https://api.openai.com/v1
